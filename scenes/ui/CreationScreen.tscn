[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/creation_screen.gd" id="1_cscr"]

; GBC stage idiom (restyle slice wave 0): the scene shrinks to root + script +
; GenTimer. The opaque 160x144 stage (Backing/ScreenViewport/ScreenDisplay),
; the frame1 step dialog, the textbox_bg1 hint band, the in-stage seed digit
; row and the NameEntry/AvatarPicker plate widgets are all built by the script
; — stage children carry EXPLICIT integer offsets only (never
; set_anchors_preset on a parented node).

[node name="CreationScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_cscr")

[node name="GenTimer" type="Timer" parent="."]
wait_time = 0.6
one_shot = true
