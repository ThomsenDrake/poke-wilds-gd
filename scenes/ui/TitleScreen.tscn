[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/title_screen.gd" id="1_tscr"]

; GBC stage idiom (restyle slice wave 0): the scene shrinks to root + script +
; SplashTimer. The 160x144 stage (Backing/ScreenViewport/ScreenDisplay), the
; splash/title cards and the contentless "Splash"/"EntryPanel" visibility
; witnesses are all built by the script — stage children carry EXPLICIT integer
; offsets only (never set_anchors_preset on a parented node).

[node name="TitleScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_tscr")

[node name="SplashTimer" type="Timer" parent="."]
wait_time = 2.0
one_shot = true
