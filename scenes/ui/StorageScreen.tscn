[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/storage_screen.gd" id="1_sscr"]

; GBC stage idiom (restyle slice wave 2): the scene shrinks to root + script.
; The opaque 160x144 stage (Backing/ScreenViewport/ScreenDisplay), the gsc
; background, and the white column/action/summary/detail/hint plates are all
; built by the script (storage_screen_stage.gd) — stage children carry EXPLICIT
; integer offsets only (never set_anchors_preset on a parented node).
; mouse_filter=PASS keeps the root _gui_input click-convenience route (the old
; ActionList item_clicked path, now a stage-inverse row hit test).

[node name="StorageScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_sscr")
