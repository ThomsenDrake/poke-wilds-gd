[ext_resource type="Script" path="res://scripts/ui/waystone_selector.gd" id="1_bsel"]

; GBC stage idiom (restyle slice wave 2): the scene shrinks to root + script.
; The opaque 160x144 stage (Backing/ScreenViewport/ScreenDisplay), the gsc
; background, and the white title/rows/hint plates are all built by the script
; (menu_list_stage.gd) — stage children carry EXPLICIT integer offsets only
; (never set_anchors_preset on a parented node). mouse_filter=PASS keeps the
; root _gui_input click-convenience route (stage-inverse row hit test).

[node name="WayStoneSelector" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_bsel")
